{
  "name": "qa.automationexercise-web.webdriverio",
  "version": "1.0.0",
  "description": "Automação Web com WebdriverIO, TypeScript e Allure Reports",
  "main": "wdio.conf.ts",
  "scripts": {
    "test": "npx wdio run wdio.conf.ts",
    "test:headless": "npx wdio run wdio.conf.ts --headless",
    "allure:generate": "npx allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "npx allure open ./allure-report",
    "allure:serve": "npx allure serve ./allure-results"
  },
  "keywords": [
    "webdriverio",
    "automation",
    "qa",
    "typescript",
    "testing",
    "allure"
  ],
  "author": "Emerson Pombo",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^24.9.2",
    "@types/webdriverio": "^4.13.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@wdio/allure-reporter": "^9.20.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/globals": "^9.17.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "chromedriver": "^142.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "expect-webdriverio": "^5.4.3",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wdio-chromedriver-service": "^8.1.1",
    "allure-commandline": "^2.29.0"
  },
  "dependencies": {
    "@babel/helper-validator-identifier": "^7.27.1",
    "js-tokens": "^4.0.0",
    "picocolors": "^1.1.1"
  },
  "engines": {
    "node": ">=6.9.0"
  }
}
